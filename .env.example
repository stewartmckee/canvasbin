# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Core ---
# DATABASE_URL=postgres://canvasbin:canvasbin@localhost:5433/canvasbin?sslmode=disable
# HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Product mode ---
# PRODUCT_TYPE=canvasbin   default: Canvasbin (multi-page library, Individual/Team billing)
# PRODUCT_TYPE=signal      separate deployment (e.g. Foghorn): one site per account, trial + paid updates product
# PRODUCT_NAME=            optional display name (defaults to Canvasbin or Foghorn when PRODUCT_TYPE=signal)

# --- Public page updates (off = no feed, subscribe, or post_update) ---
# On canvasbin.dev leave off. Required when PRODUCT_TYPE=signal.
UPDATES=off
# UPDATES_MODE=feed
# UPDATES_MODE=notify_on_page_edit

# --- Foghorn / PRODUCT_TYPE=signal (example second server) ---
# ACCOUNTS=on
# UPDATES=on
# PRODUCT_TYPE=signal
# PRODUCT_NAME=Foghorn
# PUBLIC_BASE_URL=https://foghorn.example
# STRIPE_PRICE_PRO=price_...        # Individual £4.99/mo GBP (Foghorn: £7.99/mo)
# STRIPE_PRICE_PRO_USD=price_...    # Individual $7.99/mo USD (Foghorn: $9.99/mo)
# MAIL_FROM=Foghorn <noreply@foghorn.example>

# --- Accounts (off = anonymous-only, exactly as before) ---
ACCOUNTS=off
# Comma-separated emails allowed to use /api/admin/*
ADMIN_EMAILS=

# --- Mailgun (EU region); required when ACCOUNTS=on or UPDATES=on ---
MAILGUN_SENDING_KEY=
MAILGUN_DOMAIN=canvasbin.dev
MAIL_FROM=Canvasbin <noreply@canvasbin.dev>
# One-time reminder for unverified sign-ups (default on when ACCOUNTS=on).
# Worker runs at startup and every hour; sends once per account after VERIFY_NUDGE_AFTER.
# VERIFY_NUDGE=off
# VERIFY_NUDGE_AFTER=24h
#
# Outbound email links use utm_source=email, utm_medium=transactional, and
# utm_campaign: verify_signup, verify_nudge, welcome, password_reset,
# page_share, team_invite, updates_subscribe, updates_notification
# (utm_content names the link, e.g. confirm, connect, view).


# --- Stripe billing (optional; checkout is disabled without secret key + price) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_SIGNAL=
STRIPE_PRICE_SIGNAL_USD=
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_BASE_USD=
STRIPE_PRICE_TEAM_SEAT=
STRIPE_PRICE_TEAM_SEAT_USD=
STRIPE_PUBLISHABLE_KEY=

# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Core ---
# DATABASE_URL=postgres://canvasbin:canvasbin@localhost:5433/canvasbin?sslmode=disable
# HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Public page updates (off = no feed, subscribe, or post_update) ---
UPDATES=off
# UPDATES_MODE=feed
# UPDATES_MODE=notify_on_page_edit
# PRODUCT_NAME=Canvasbin

# --- Accounts (off = anonymous-only, exactly as before) ---
ACCOUNTS=off
# Comma-separated emails allowed to use /api/admin/*
ADMIN_EMAILS=

# --- Mailgun (EU region); required when ACCOUNTS=on or UPDATES=on ---
MAILGUN_SENDING_KEY=
MAILGUN_DOMAIN=canvasbin.dev
MAIL_FROM=Canvasbin <noreply@canvasbin.dev>

# --- Stripe billing (optional; checkout is disabled without secret key + price) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM_BASE=
STRIPE_PRICE_TEAM_SEAT=
STRIPE_PUBLISHABLE_KEY=
